# Black Magic Probe (BMP) — native USB mode
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="6018", MODE="0666", GROUP="plugdev", SYMLINK+="ttyBmpGdb%n"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="6018", ENV{ID_USB_INTERFACE_NUM}=="01", MODE="0666", GROUP="plugdev", SYMLINK+="ttyBmpTarg%n"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="6018", MODE="0666", GROUP="plugdev"

# BMP — DFU mode
SUBSYSTEM=="usb", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="6017", MODE="0666", GROUP="plugdev"
